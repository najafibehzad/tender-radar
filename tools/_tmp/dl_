<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>رادار مناقصات — شهرداری‌ها و دهیاری‌های البرز و تهران</title>
<meta name="description" content="استخراج، جستجو و پایش آگهی‌های مناقصه، مزایده و استعلام شهرداری‌ها و دهیاری‌های استان‌های تهران و البرز">
<link rel="stylesheet" href="/styles.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
</head>
<body>
<div class="app">

  <header class="top">
    <div class="top-inner">
      <div class="brand">
        <div class="logo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4"></circle><path d="M12 3v3M12 18v3M3 12h3M18 12h3"></path>
          </svg>
        </div>
        <div>
          <h1>رادار مناقصات</h1>
          <div class="sub">شهرداری‌ها و دهیاری‌های استان‌های تهران و البرز</div>
        </div>
      </div>
      <div class="top-actions">
        <span id="lastScan" class="meta muted" style="font-size:12.5px"></span>
        <button class="btn" id="btnSources" title="مدیریت شهرها و منابع">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
          شهرها و منابع
        </button>
        <button class="btn" id="btnSettings" title="تنظیمات">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2V21a2 2 0 1 1-4 0v-.1A1.7 1.7 0 0 0 7 19.4a1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0-1.2-2.9H1a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 2.6 7a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H7a1.7 1.7 0 0 0 1-1.5V1a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V7a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
          تنظیمات
        </button>
        <button class="btn icon" id="btnTheme" title="تغییر پوسته">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <button class="btn primary" id="btnScan">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-3-6.7M21 3v6h-6"/></svg>
          اسکن منابع
        </button>
      </div>
    </div>
    <div class="progress" id="scanProgress" style="display:none"><div class="bar" id="scanBar"></div></div>
  </header>

  <div class="searchbar">
    <div class="search-wrap">
      <svg class="mag" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="q" type="search" placeholder="جستجوی موضوع مناقصه… مثلاً: آسفالت، جدول‌گذاری، تخریب و بازسازی، فضای سبز، لوله‌گذاری" autocomplete="off">
      <button class="search-clear" id="qClear" title="پاک کردن">×</button>
    </div>
  </div>

  <div class="chips" id="topicChips"></div>

  <div class="filters">
    <select id="fProvince"><option value="">همهٔ استان‌ها</option></select>
    <select id="fCity"><option value="">همهٔ شهرها</option></select>
    <select id="fKind"><option value="">همهٔ انواع</option></select>
    <select id="fSource"><option value="">همهٔ منابع</option></select>
    <select id="fDays">
      <option value="">همهٔ تاریخ‌ها</option>
      <option value="1">امروز و دیروز</option>
      <option value="3">۳ روز گذشته</option>
      <option value="7">۱ هفته گذشته</option>
      <option value="30">۱ ماه گذشته</option>
    </select>
    <select id="fSort">
      <option value="newest">جدیدترین انتشار</option>
      <option value="deadline">نزدیک‌ترین مهلت</option>
      <option value="oldest">قدیمی‌ترین</option>
      <option value="city">به ترتیب شهر</option>
      <option value="source">به ترتیب منبع</option>
    </select>
    <label class="toggle-lbl" id="lblDeadline"><input type="checkbox" id="fDeadline"> فقط دارای مهلت</label>
    <label class="toggle-lbl" id="lblToday"><input type="checkbox" id="fToday"> فقط امروز</label>
    <div class="spacer"></div>
    <button class="btn sm" id="btnReset">پاک‌کردن فیلترها</button>
  </div>

  <main>
    <div class="kpis" id="kpis"></div>

    <div class="resbar">
      <span class="count" id="resCount">—</span>
      <span class="meta" id="resMeta"></span>
      <div class="spacer"></div>
      <div class="viewtabs">
        <button data-view="table" class="on">جدول</button>
        <button data-view="cards">کارت</button>
      </div>
      <button class="btn sm" id="btnCsv">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
        اکسل (CSV)
      </button>
      <button class="btn sm" id="btnJson">JSON</button>
      <button class="btn sm" id="btnPrint">چاپ</button>
      <button class="btn sm" id="btnCopy">کپی فهرست</button>
    </div>

    <div id="results"></div>

    <details class="panel" id="panelSources">
      <summary>وضعیت منابع (شهرها، دهیاری‌ها و تجمیع‌کننده‌ها)</summary>
      <div class="panel-body">
        <div class="srcgrid" id="srcGrid"></div>
      </div>
    </details>

    <details class="panel">
      <summary>راهنما و نکات</summary>
      <div class="panel-body" id="helpBody"></div>
    </details>
  </main>
</div>

<!-- مودال مدیریت شهرها و منابع -->
<div class="modal-bg" id="modalSources">
  <div class="modal">
    <div class="modal-head">
      <h3>شهرها و منابع</h3>
      <button class="btn ghost sm" data-close="modalSources">بستن</button>
    </div>
    <div class="modal-body">
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px">
        <button class="btn primary sm" id="tabAddCity">افزودن شهر / منبع جدید</button>
        <button class="btn sm" id="tabListSrc">فهرست منابع</button>
        <button class="btn sm" id="tabTopics">موضوعات جستجو</button>
      </div>

      <div id="paneAddCity">
        <div class="formgrid">
          <div class="field">
            <label>نام شهر / سازمان</label>
            <input id="aName" placeholder="مثال: شهرداری هشتگرد">
          </div>
          <div class="field">
            <label>نشانی سایت</label>
            <input id="aUrl" placeholder="https://example.ir" dir="ltr">
            <span class="hint">فقط دامنه کافی است؛ مسیر آگهی‌ها خودکار کشف می‌شود.</span>
          </div>
          <div class="field">
            <label>شهر</label>
            <input id="aCity" placeholder="مثال: هشتگرد">
          </div>
          <div class="field">
            <label>استان</label>
            <input id="aProvince" placeholder="مثال: البرز">
          </div>
          <div class="field">
            <label>نوع سازمان</label>
            <select id="aType">
              <option>شهرداری</option><option>دهیاری</option><option>شورای شهر</option>
              <option>استانداری</option><option>تجمیع‌کننده</option><option>سایر</option>
            </select>
          </div>
          <div class="field">
            <label>روش استخراج</label>
            <select id="aAdapter">
              <option value="auto">تشخیص خودکار (پیشنهادی)</option>
              <option value="wordpress">وردپرس (REST API)</option>
              <option value="html">صفحهٔ HTML</option>
              <option value="rss">فید RSS</option>
              <option value="sitemap">نقشهٔ سایت</option>
            </select>
          </div>
          <div class="field wide">
            <label>مسیرهای اختصاصی آگهی‌ها (اختیاری)</label>
            <textarea id="aPages" rows="2" dir="ltr" placeholder="هر نشانی در یک خط — مثال:&#10;https://example.ir/مناقصات"></textarea>
            <span class="hint">اگر خالی بماند، صفحهٔ اصلی و مسیرهای متداول بررسی می‌شوند.</span>
          </div>
        </div>
        <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
          <button class="btn" id="btnDetect">بررسی و شناسایی سایت</button>
          <button class="btn primary" id="btnAddSource">افزودن</button>
        </div>
        <div id="detectOut" style="margin-top:14px"></div>
      </div>

      <div id="paneListSrc" style="display:none">
        <div id="srcListFull"></div>
      </div>

      <div id="paneTopics" style="display:none">
        <div class="formgrid">
          <div class="field"><label>نام موضوع</label><input id="tName" placeholder="مثال: آسانسور"></div>
          <div class="field wide"><label>کلیدواژه‌ها (با کاما)</label><input id="tWords" placeholder="آسانسور، بالابر، پله برقی"></div>
        </div>
        <button class="btn primary sm" id="btnAddTopic" style="margin-top:10px">افزودن موضوع</button>
        <div id="topicList" style="margin-top:14px"></div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" data-close="modalSources">بستن</button>
    </div>
  </div>
</div>

<!-- مودال تنظیمات -->
<div class="modal-bg" id="modalSettings">
  <div class="modal" style="max-width:520px">
    <div class="modal-head"><h3>تنظیمات</h3><button class="btn ghost sm" data-close="modalSettings">بستن</button></div>
    <div class="modal-body">
      <div class="formgrid">
        <div class="field">
          <label>اسکن خودکار هر … دقیقه (۰ = خاموش)</label>
          <input type="number" id="sInterval" min="0" max="1440" value="0">
        </div>
        <div class="field">
          <label>بازهٔ بازیابی (روز)</label>
          <input type="number" id="sLookback" min="7" max="730" value="150">
        </div>
        <div class="field">
          <label>مهلت درخواست هر سایت (میلی‌ثانیه)</label>
          <input type="number" id="sTimeout" min="5000" max="120000" step="1000" value="30000">
        </div>
        <div class="field">
          <label>حداکثر آگهی از هر منبع</label>
          <input type="number" id="sMax" min="20" max="2000" step="10" value="300">
        </div>
      </div>
      <label class="toggle-lbl" style="margin-top:12px"><input type="checkbox" id="sAuto"> اسکن خودکار هنگام اجرای برنامه</label>
    </div>
    <div class="modal-foot">
      <button class="btn" id="btnResetCache">پاک‌کردن نتایج ذخیره‌شده</button>
      <button class="btn primary" id="btnSaveSettings">ذخیره</button>
    </div>
  </div>
</div>

<!-- کشوی جزئیات -->
<div class="drawer-bg" id="drawerBg"></div>
<aside class="drawer" id="drawer">
  <div class="drawer-head">
    <h3 id="dTitle" style="font-size:15px;line-height:1.7"></h3>
    <button class="btn ghost sm" id="dClose" style="margin-inline-start:auto">بستن</button>
  </div>
  <div class="drawer-body" id="dBody"></div>
</aside>

<div id="toasts"></div>
<script src="/app.js"></script>
</body>
</html>
